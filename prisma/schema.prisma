// Destino Certo — Schema do banco de dados

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCEIRO
  OPERADOR
  ATENDENTE
  VISUALIZADOR
}

enum ExcursionStatus {
  RASCUNHO
  ATIVA
  ENCERRADA
}

enum PresetType {
  PACOTE
  BLOCO
}

enum TransactionKind {
  RECEBIMENTO
  PAGAMENTO
}

enum SaleStatus {
  ORCAMENTO
  CONFIRMADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(ADMIN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  excursions   Excursion[]
  presets      Preset[]
  notes        Note[]
  drawings     CanvasDrawing[]
  assignedTasks Task[]
}

model Excursion {
  id               String          @id @default(cuid())
  name             String
  destination      String?
  destinationsJson Json?
  latitude         Float?
  longitude        Float?
  periodStart      DateTime?
  periodEnd        DateTime?
  slots            Int             @default(0)
  status           ExcursionStatus @default(RASCUNHO)
  itineraryJson    Json?
  addonsJson       Json?
  profitMargin     Float?          @default(0)
  customProfitAmount Float?
  customPackagePrice Float?
  shareCode        String?         @unique
  sharePassword    String?
  isShareActive    Boolean         @default(true)
  createdById      String?
  createdBy        User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  blocks           Block[]
  transactions     Transaction[]
  sales            Sale[]

  @@index([status])
  @@index([createdAt])
  @@index([periodStart, periodEnd])
  @@index([createdById])
}

model Block {
  id          String    @id @default(cuid())
  excursionId String
  excursion   Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)
  type        String
  title       String
  order       Int
  configJson  Json      // colunas/linhas das tabelas dinâmicas
  collapsed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([excursionId, order])
}

model Preset {
  id          String     @id @default(cuid())
  name        String
  type        PresetType
  payloadJson Json
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
}

model Transaction {
  id            String          @id @default(cuid())
  excursionId   String?
  excursion     Excursion?      @relation(fields: [excursionId], references: [id], onDelete: SetNull)
  kind          TransactionKind
  amount        Decimal         @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  passengerName String?
  createdAt     DateTime        @default(now())

  @@index([kind, dueDate])
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  cpf           String?
  rg            String?
  passport      String?
  birthDate     DateTime?
  gender        String?
  phone         String?
  mobile        String?
  email         String?
  address       String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  notes         String?
  mondeId       String?   @unique
  firstSaleDate DateTime?
  lastSaleDate  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  financialEntries FinancialEntry[]
  trips            CustomerTrip[]
  salesAsPayer     Sale[]
  salePassengers   SalePassenger[]
  tasks            Task[]

  @@index([name])
  @@index([cpf])
  @@index([mobile])
  @@index([birthDate])
  @@index([city, state])
}

model CustomerTrip {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  groupName      String    // Ex: "PACOTE JATIÚCA OUTUBRO 2025" ou "Viagem Fernando de Noronha"
  destination    String?   // Ex: "Maceió - AL" ou "Nacional"
  departureDate  DateTime?
  returnDate     DateTime?
  saleNumber     String?
  role           String    @default("PASSAGEIRO") // "PASSAGEIRO" | "PAGANTE" | "PAGANTE_E_PASSAGEIRO"
  isGroupTrip    Boolean   @default(false)        // true se for Operação Própria (Grupo/Excursão)
  
  companionsJson Json?     // Array de { customerId, name } que viajaram juntos nesta mesma reserva
  
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([groupName])
  @@index([departureDate])
  @@index([saleNumber])
  @@index([isGroupTrip])
}

model Supplier {
  id           String           @id @default(cuid())
  name         String
  tradeName    String?
  cnpj         String?
  ie           String?
  category     String?
  phone        String?
  mobile       String?
  email        String?
  website      String?
  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  notes        String?
  mondeId      String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  financialEntries FinancialEntry[]
  saleItems        SaleItem[]

  @@index([name])
  @@index([tradeName])
  @@index([cnpj])
  @@index([category])
  @@index([city, state])
}

model FinancialEntry {
  id          String    @id @default(cuid())
  mondeId     String?   @unique
  kind        String    // "RECEBIMENTO" | "PAGAMENTO"
  description String
  document    String?
  amount      Decimal   @db.Decimal(12, 2)
  issueDate   DateTime? // Data de emissão (do título no Monde)
  dueDate     DateTime
  paidAt      DateTime?
  status      String    @default("PENDENTE") // "PAGO" | "PENDENTE"

  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  saleId      String?
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  paymentMethod     String?   // "PIX", "CARTAO_CREDITO", "CARTAO_DEBITO", "BOLETO", "DINHEIRO", "BANCO", "CREDITO", "OUTROS"
  paymentMethodName String?   // "PIX", "Cartão de Crédito", "Boleto", etc.

  createdAt   DateTime  @default(now())

  bankTransactions BankTransaction[]

  @@index([customerId])
  @@index([supplierId])
  @@index([saleId])
  @@index([issueDate])
  @@index([kind, dueDate])
  @@index([status])
  @@index([status, dueDate])
  @@index([kind, status, dueDate])
  @@index([paymentMethod])
  @@index([kind, paymentMethod])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("sticky") // "sticky" | "text"
  fontSize  String?  @default("base")   // "base" | "lg" | "xl" | "2xl"
  title     String?
  content   String   @default("")
  color     String   @default("yellow") // "yellow" | "blue" | "green" | "pink" | "purple" | "orange" | "white"
  posX      Float    @default(100)
  posY      Float    @default(100)
  rotation  Float    @default(0)
  sticker   String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model CanvasDrawing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathData    String
  color       String   @default("#F59E0B")
  strokeWidth Float    @default(3)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ==========================================
// MÓDULOS REPLICADOS DO MONDE ERP
// ==========================================

model BankAccount {
  id             String   @id @default(cuid())
  mondeId        String?  @unique
  name           String   // Ex: "Banco do Brasil", "APLICAÇÃO", "Conta Stone - George"
  bankCode       String?  // Ex: "001", "22397"
  agency         String?
  accountNumber  String?
  type           String   @default("CORRENTE") // "CORRENTE", "APLICACAO", "CAIXA", "CARTAO"
  initialBalance Decimal  @default(0) @db.Decimal(12, 2)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   BankTransaction[]
  transfersFrom  BankTransfer[] @relation("TransfersFrom")
  transfersTo    BankTransfer[] @relation("TransfersTo")

  @@index([active])
}

model BankTransaction {
  id               String          @id @default(cuid())
  mondeId          String?         @unique
  accountId        String
  account          BankAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  financialEntryId String?
  financialEntry   FinancialEntry? @relation(fields: [financialEntryId], references: [id], onDelete: SetNull)

  date             DateTime        // Data da liquidação/extrato
  amount           Decimal         @db.Decimal(12, 2) // Positivo (Crédito) ou Negativo (Débito)
  description      String
  document         String?         // "PIX", "BOLETO", "DEPOSITO"
  isReconciled     Boolean         @default(false)
  categoryName     String?         // "RECEITA DE VENDAS", "FORNECEDOR (PASSAGEM AEREA)", "TARIFA BANCARIA"
  personName       String?
  personDoc        String?
  paymentMethod     String?         // "PIX", "CARTAO_CREDITO", "BOLETO", "DINHEIRO", etc.
  paymentMethodName String?

  createdAt        DateTime        @default(now())

  @@index([accountId, date])
  @@index([date])
  @@index([paymentMethod])
}

model BankTransfer {
  id            String      @id @default(cuid())
  fromAccountId String
  fromAccount   BankAccount @relation("TransfersFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     BankAccount @relation("TransfersTo", fields: [toAccountId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  date          DateTime
  description   String?     // Ex: "Transferência para APLICAÇÃO"
  createdAt     DateTime    @default(now())

  @@index([fromAccountId, date])
  @@index([toAccountId, date])
}

model Seller {
  id             String       @id @default(cuid())
  mondeId        String?      @unique
  name           String
  email          String?
  phone          String?
  commissionRate Float        @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  sales          Sale[]
  goals          SellerGoal[]

  @@index([name])
}

model SellerGoal {
  id             String   @id @default(cuid())
  sellerId       String
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  month          String   // "2026-09"
  targetAmount   Decimal  @db.Decimal(12, 2)
  achievedAmount Decimal  @default(0) @db.Decimal(12, 2)

  @@index([sellerId, month])
}

model Sale {
  id             String          @id @default(cuid())
  mondeId        String?         @unique
  saleNumber     String          @unique // Ex: "3849"
  customerId     String          // Pagante da venda
  customer       Customer        @relation(fields: [customerId], references: [id])
  sellerId       String?         // Vendedor responsável
  seller         Seller?         @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  excursionId    String?         // Vínculo se for excursão própria
  excursion      Excursion?      @relation(fields: [excursionId], references: [id], onDelete: SetNull)

  saleDate       DateTime        @default(now())
  departureDate  DateTime?
  returnDate     DateTime?
  status         SaleStatus      @default(CONFIRMADA)

  totalProducts  Decimal         @default(0) @db.Decimal(12, 2)
  totalTaxes     Decimal         @default(0) @db.Decimal(12, 2)
  serviceFee     Decimal         @default(0) @db.Decimal(12, 2)
  discount       Decimal         @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal         @db.Decimal(12, 2)

  notes          String?
  financialNotes String?
  primaryPaymentMethod String? // "PIX", "CARTAO_CREDITO", "BOLETO", "DINHEIRO", "MISTO"

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          SaleItem[]
  passengers     SalePassenger[]
  financialEntries FinancialEntry[]

  @@index([saleNumber])
  @@index([customerId])
  @@index([sellerId])
  @@index([saleDate])
  @@index([status])
  @@index([primaryPaymentMethod])
}

model SaleItem {
  id             String    @id @default(cuid())
  saleId         String
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  type           String    // "AEREO", "HOSPEDAGEM", "PACOTE", "SEGURO", "TRANSFER", "CRUZEIRO"
  description    String
  startDate      DateTime?
  endDate        DateTime?
  quantity       Int       @default(1)
  unitPrice      Decimal   @db.Decimal(12, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal   @db.Decimal(12, 2)

  // Detalhes Aéreos
  airlineCode    String?
  locCode        String?   // Localizador (PNR)
  ticketNumber   String?

  // Detalhes Hospedagem
  roomType       String?
  boardType      String?   // "Café da manhã", "All Inclusive"

  createdAt      DateTime  @default(now())

  @@index([saleId])
  @@index([supplierId])
}

model SalePassenger {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  role       String   @default("PASSAGEIRO") // "PASSAGEIRO", "PAGANTE", "PAGANTE_E_PASSAGEIRO"
  seatNumber String?
  ticketCode String?

  @@unique([saleId, customerId])
  @@index([customerId])
  @@index([saleId])
}

model Task {
  id           String        @id @default(cuid())
  mondeId      String?       @unique
  title        String
  description  String?
  category     String        @default("Geral") // "Pós-venda", "Cobrança", "Follow-up", "Emissão"
  priority     String        @default("MEDIA") // "BAIXA", "MEDIA", "ALTA", "URGENTE"
  status       String        @default("PENDENTE") // "PENDENTE", "EM_ANDAMENTO", "CONCLUIDA"
  dueDate      DateTime?

  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  history      TaskHistory[]

  @@index([status, dueDate])
  @@index([customerId])
  @@index([assignedToId])
}

model TaskHistory {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actionNote String
  authorName String   @default("Sistema")
  createdAt  DateTime @default(now())

  @@index([taskId])
}
